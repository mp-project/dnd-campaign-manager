NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BACKEND_PUBLIC_BASE_URL=http://api.localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:55432/dnd_campaign_manager
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55433/dnd_campaign_manager_test
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@api.localhost
MAIL_FROM_NAME=DnD Campaign Manager
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAILPIT_UI_URL=http://127.0.0.1:8025
EMAIL_VERIFICATION_SECRET=replace-with-email-verification-secret
EMAIL_VERIFICATION_CODE_TTL_HOURS=24
LOG_LEVEL=info
CORS_ORIGIN=http://app.localhost:5173
FRONTEND_ORIGIN=http://app.localhost:5173
VITE_API_BASE_URL=http://api.localhost:3000/api/v1
OAUTH_STATE_SECRET=replace-with-oauth-state-secret
# Set CLIENT_ID, CLIENT_SECRET and CALLBACK_URL together to enable a provider.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_CALLBACK_URL=
# Use s3 in container and production environments (recommended default).
STORAGE_DRIVER=s3
# Only used when STORAGE_DRIVER=local (for local dev without object storage).
STORAGE_LOCAL_ROOT=var/storage
STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,audio/mpeg,audio/wav,audio/ogg,video/mp4,video/webm
STORAGE_DOWNLOAD_URL_TTL_SECONDS=900
# Local RustFS endpoint for backend running on host.
STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
STORAGE_S3_DASHBOARD_URL=http://127.0.0.1:9001
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=replace-with-bucket-name
STORAGE_S3_ACCESS_KEY_ID=replace-with-access-key-id
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
STORAGE_S3_FORCE_PATH_STYLE=true
# If true, backend ensures bucket and download CORS on startup (useful with local RustFS).
STORAGE_S3_AUTO_BOOTSTRAP=true
# Comma-separated browser origins allowed to fetch signed S3 download URLs.
STORAGE_S3_BOOTSTRAP_CORS_ORIGINS=http://app.localhost:5173,https://app.localhost:8443
# RustFS container credentials for local compose; keep in sync with STORAGE_S3_* values above.
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=replace-with-access-key-id
RUSTFS_SECRET_KEY=replace-with-secret-access-key
STORAGE_MAX_UPLOAD_BYTES=5242880
STORAGE_MAX_TOTAL_BYTES=104857600
