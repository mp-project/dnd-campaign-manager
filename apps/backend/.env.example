NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BACKEND_PUBLIC_BASE_URL=http://api.localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:55432/dnd_campaign_manager
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55433/dnd_campaign_manager_test
# Redis of compose (password REDIS_PASSWORD, port REDIS_PORT below): rate limits shared by all
# API instances and caches. Empty = per process (fine for one local process); required in stage/production.
REDIS_URL=redis://:redis@127.0.0.1:56380/0
# Integration tests with Redis (compose profile test, flushed per test; never database 0).
TEST_REDIS_URL=redis://127.0.0.1:56379/1
# --- Clerk (sign-in, registration, waitlist; dashboard.clerk.com → API keys) ---
# Secret key of the instance (development: sk_test_…); without it nobody is signed in.
CLERK_SECRET_KEY=
# Optional: the instance's JWT public key (PEM), so session tokens are checked without fetching the JWKS.
CLERK_JWT_KEY=
# Frontend origins whose session tokens count (comma separated); empty = FRONTEND_ORIGIN.
CLERK_AUTHORIZED_PARTIES=http://app.localhost:5173,https://app.localhost:8443
# Signing secret of the webhook (whsec_…; endpoint …/api/v1/webhooks/clerk, events user.*, session.created).
CLERK_WEBHOOK_SIGNING_SECRET=
# The account that signs in with this verified address becomes the first system maintainer.
BOOTSTRAP_MAINTAINER_EMAIL=
MAIL_DRIVER=smtp
# Sender of the app's mails; production: benachrichtigung@<domain> over mailbox.org SMTP.
MAIL_FROM_ADDRESS=benachrichtigung@app.localhost
MAIL_FROM_NAME=Questaria
# Where answers to the app's mails go (production: kontakt@<domain>); empty = to the sender.
MAIL_REPLY_TO=kontakt@app.localhost
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAILPIT_UI_URL=http://127.0.0.1:8025
# Recipient of the contact form (/kontakt); empty = the form answers 503.
CONTACT_EMAIL_TO=kontakt@app.localhost
# Signs the contact form's JS challenge (at least 32 characters); empty = random per process.
CONTACT_CHALLENGE_SECRET=replace-with-contact-challenge-secret-0000
# Lowest level written to stdout (trace, debug, info, warn, error, fatal, silent).
LOG_LEVEL=info
# New values in the `change` log lines (never account or secret fields); false = ids and field names only.
LOG_CHANGE_VALUES=true
# Readable single lines in the terminal; false = JSON (stage, production).
LOG_PRETTY=true
# Key for the hashed client IP in request logs (at least 16 characters); empty = random per process.
LOG_IP_HASH_SECRET=

# --- Grafana Cloud (OpenTelemetry: logs → Loki, traces → Tempo, metrics → Mimir) ---
# Empty endpoint = no telemetry at all (locally, tests, CI). Values from Grafana Cloud → your stack →
# Connections → OpenTelemetry (OTLP): the endpoint ends in /otlp, the SDK appends /v1/traces etc.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic%20<base64 of "<instance id>:<access policy token>"> (the %20 is the space).
# Create it with: printf '%s' '<instance id>:<token>' | base64
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Lowest level sent to Grafana; independent of LOG_LEVEL. Start with trace to see everything, later warn.
LOG_EXPORT_LEVEL=trace
# Share of traces kept (parentbased: a sampled caller keeps the whole trace). 1.0 = all, e.g. 0.1 later.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Set by the start commands (questaria-api, questaria-media-worker); leave it out here.
# OTEL_SERVICE_NAME=
# true switches telemetry off without removing the endpoint.
OTEL_SDK_DISABLED=false
# Create the default rulesets (D&D 5E 2014/2024) at start, once per version.
DEFAULT_RULESETS_ON_START=true
CORS_ORIGIN=http://app.localhost:5173
FRONTEND_ORIGIN=http://app.localhost:5173
# Use s3 in container and production environments (recommended default).
STORAGE_DRIVER=s3
# Only used when STORAGE_DRIVER=local (for local dev without object storage).
STORAGE_LOCAL_ROOT=var/storage
STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,audio/mpeg,audio/wav,audio/ogg,video/mp4,video/webm
# Rights checks only happen when a link is issued, so a revoked right can last up to twice this time.
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
# Local RustFS endpoint for backend running on host.
STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# Address browsers reach the storage at, if it differs from the endpoint. Signed links contain it. It must
# not be the origin of the app, because uploaded files are served from there.
# STORAGE_S3_PUBLIC_ENDPOINT=https://s3.example.com
STORAGE_S3_DASHBOARD_URL=http://127.0.0.1:9001
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=replace-with-bucket-name
STORAGE_S3_ACCESS_KEY_ID=replace-with-access-key-id
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
STORAGE_S3_FORCE_PATH_STYLE=true
# If true, backend ensures bucket and download CORS on startup (useful with local RustFS).
STORAGE_S3_AUTO_BOOTSTRAP=true
# Comma-separated browser origins allowed to fetch signed S3 download URLs.
STORAGE_S3_BOOTSTRAP_CORS_ORIGINS=http://app.localhost:5173,https://app.localhost:8443
# RustFS container credentials for local compose (the compose backend uses them as its STORAGE_S3_* values);
# keep in sync with STORAGE_S3_* above for the backend on the host.
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=replace-with-access-key-id
RUSTFS_SECRET_KEY=replace-with-secret-access-key

# --- Sentry (errors; tracing stays with OpenTelemetry/Grafana) ---
# DSN of the backend project (Sentry → Settings → Projects → questaria-server → Client Keys); empty = off.
SENTRY_DSN=
# Lowest level of log lines sent to Sentry Logs (shown with the issues). Start with trace, later warn.
SENTRY_LOG_LEVEL=trace
# Release (git SHA) the events belong to; compose sets it from APP_RELEASE.
SENTRY_RELEASE=

# --- Docker Compose (`npm run compose -- …` reads this file and apps/frontend/.env; there is no root .env) ---
# Environment of the compose stack: profile, NODE_ENV of the containers, robots rules of Caddy, frontend build.
APP_ENV=development
COMPOSE_PROFILES=development
# Release (git SHA) for Sentry and Faro of the compose stack; empty locally.
APP_RELEASE=
# Password of the compose database (required). Use a long random value outside development; it is part of
# DATABASE_URL (above and in the containers), so stick to [A-Za-z0-9]. An existing volume keeps the password
# it was created with.
POSTGRES_PASSWORD=postgres
# Password of the compose Redis (required; only the local host reaches it). Part of REDIS_URL above, so keep
# both in step and stick to [A-Za-z0-9].
REDIS_PASSWORD=redis
# Host ports of compose; the defaults match DATABASE_URL, TEST_DATABASE_URL, REDIS_URL and TEST_REDIS_URL above.
# DB_PORT=55432
# REDIS_PORT=56380
# TEST_DB_PORT=55433
# TEST_RUSTFS_PORT=59000
# TEST_REDIS_PORT=56379
# DB_DASHBOARD_PORT=8081
# RUSTFS_API_PORT=9000
# RUSTFS_DASHBOARD_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
# Host names and public addresses behind Caddy (defaults: api.localhost, app.localhost, s3.localhost, port 8443).
# API_DOMAIN=api.localhost
# FRONTEND_DOMAIN=app.localhost
# S3_DOMAIN=s3.localhost
# COMPOSE_BACKEND_PUBLIC_BASE_URL=https://api.localhost:8443
# COMPOSE_BACKEND_PUBLIC_API_URL=https://api.localhost:8443/api/v1
# COMPOSE_FRONTEND_PUBLIC_URL=https://app.localhost:8443
# COMPOSE_STORAGE_S3_PUBLIC_ENDPOINT=https://s3.localhost:8443
# COMPOSE_MAILPIT_UI_URL=http://localhost:8025
