{
  "name": "@dnd/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "build": "vue-tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "api:types": "npm run -s openapi:export --workspace @dnd/backend -- ../frontend/.openapi/openapi.json && openapi-typescript .openapi/openapi.json -o src/core/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@tanstack/vue-query": "^5.107.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.1"
  }
}
