FRONTEND_HOST=app.localhost
FRONTEND_PORT=5173
# Same origin through the Vite proxy; the proxy forwards /api to API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://api.localhost:3000
VITE_PUSHER_BEAMS_INSTANCE_ID=
# Clerk's publishable key (pk_test_…/pk_live_…); without it the sign-in pages say sign-in is unavailable.
VITE_CLERK_PUBLISHABLE_KEY=
# Public address of the site for canonical links, link previews and the sitemap; empty = the current origin.
VITE_SITE_URL=http://app.localhost:5173
# Public demo (the clickdummy, own container on a subdomain), linked from the start page; empty hides the links.
# Locally the clickdummy's dev server (`cd clickdummy && npm run dev`).
VITE_DEMO_URL=http://localhost:5180/
# Cookiebot domain group id (data-cbid, public). The free plan only answers on the registered domain,
# so leave it empty locally; empty = no banner, nothing optional (Faro) starts.
VITE_COOKIEBOT_ID=
# Development without Cookiebot: `statistics` acts as if the visitor allowed statistics (starts Faro).
VITE_DEV_CONSENT=
# Google Tag Manager container for Google Analytics (GTM-…); loads only after consent to statistics,
# locally only with VITE_DEV_CONSENT=statistics. Empty = no analytics.
VITE_GTM_ID=
# Grafana Faro collector (Grafana Cloud → Frontend Observability → your app → Web SDK configuration),
# e.g. https://faro-collector-prod-eu-west-2.grafana.net/collect/<key>; empty = no frontend observability.
VITE_FARO_URL=
# Lowest level of the app's log lines sent to Faro (debug, info, warn, error). Start with debug, later warn.
VITE_LOG_REMOTE_LEVEL=debug
# Environment and release shown in Faro (compose builds take APP_ENV and APP_RELEASE from apps/backend/.env).
VITE_APP_ENV=development
VITE_APP_RELEASE=
# Sentry DSN of the frontend project (questaria-frontend); empty = no error reporting. Errors are always
# reported; Session Replay only with the consent for statistics.
VITE_SENTRY_DSN=
# Share of sessions Session Replay records (only with consent), and of sessions with an error.
VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
# Only for builds that upload source maps to Sentry (CI/deploy, compose build secret); a secret, leave empty locally.
SENTRY_AUTH_TOKEN=
