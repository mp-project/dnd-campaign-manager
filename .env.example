APP_ENV=development
COMPOSE_PROFILES=${COMPOSE_PROFILES:-${APP_ENV:-production}}

CONTAINER_HOST=0.0.0.0
BACKEND_PORT=3100
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
DB_PORT=55432
# Password of the compose database (required). Use a long random value outside development;
# it is part of DATABASE_URL, so URL-encode special characters or stick to [A-Za-z0-9].
# An existing volume keeps the password it was created with.
POSTGRES_PASSWORD=postgres
# Local Adminer dashboard (development profile only)
DB_DASHBOARD_PORT=8081
TEST_DB_PORT=55433
TEST_RUSTFS_PORT=59000
TEST_REDIS_PORT=56379
# Redis of compose (required; rate limits, caches, later realtime and queues). Use a long random value
# outside development; it is part of REDIS_URL, so stick to [A-Za-z0-9]. Only the local host reaches it.
REDIS_PASSWORD=redis
REDIS_PORT=56380
DB_INTERNAL_PORT=5432
DB_TEST_INTERNAL_PORT=5432
API_DOMAIN=api.localhost
FRONTEND_DOMAIN=app.localhost
COMPOSE_BACKEND_PUBLIC_BASE_URL=https://api.localhost:8443
COMPOSE_BACKEND_PUBLIC_API_URL=https://api.localhost:8443/api/v1
COMPOSE_FRONTEND_PUBLIC_URL=https://app.localhost:8443
COMPOSE_MAILPIT_UI_URL=http://localhost:8025
S3_DOMAIN=s3.localhost
COMPOSE_STORAGE_S3_PUBLIC_ENDPOINT=https://s3.localhost:8443

# Local helper services (development profile only)
RUSTFS_API_PORT=9000
RUSTFS_DASHBOARD_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Clerk's publishable key for the production frontend build (sign-in, registration, waitlist)
CLERK_PUBLISHABLE_KEY=

# Pusher Beams instance id for the production frontend build (optional, public value; empty disables push)
PUSHER_BEAMS_INSTANCE_ID=

# Address of the public demo (the clickdummy on its own subdomain) for the start page of the production
# frontend build (optional; empty hides the demo links)
DEMO_URL=

# Recipient of the contact form (/kontakt), e.g. kontakt@<domain>; empty = the form answers 503.
CONTACT_EMAIL_TO=
# Where answers to the app's mails go; empty = kontakt@<FRONTEND_DOMAIN>.
MAIL_REPLY_TO=
# New values in the API's `change` log lines; set false once the data looks right.
LOG_CHANGE_VALUES=true
# Signs the contact form's JS challenge (at least 32 characters); empty = random per start, one API instance only.
CONTACT_CHALLENGE_SECRET=

# Cookiebot domain group id for the production frontend build (public; empty = no banner, no Faro).
COOKIEBOT_ID=
# Google Tag Manager container (GTM-…) for Google Analytics in the frontend build; only after consent.
GTM_ID=
# Grafana Faro collector for the production frontend build; starts only after consent to statistics.
FARO_URL=
# Lowest level of the frontend's log lines sent to Faro (debug, info, warn, error).
LOG_REMOTE_LEVEL=info
# Release (git SHA) shown in Faro, e.g. set by the deployment.
APP_RELEASE=
# Sentry DSN of the frontend project for the production frontend build (public; empty = no error reporting).
SENTRY_FRONTEND_DSN=
# Share of sessions Session Replay records after consent.
SENTRY_REPLAY_SAMPLE_RATE=0.1
# Sentry auth token for uploading the frontend's source maps during the production build (secret, scope
# project:releases; empty = no upload, stack traces stay minified). Never commit it.
SENTRY_AUTH_TOKEN=
