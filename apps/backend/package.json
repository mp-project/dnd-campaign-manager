{
  "name": "@dnd/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#core/*": {
      "development": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#test/*": {
      "development": "./tests/*.ts",
      "default": "./tests/*.js"
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --import ./src/instrumentation.ts src/index.ts",
    "clean": "rimraf dist coverage",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:generate-migration": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate": "npm run db:generate-migration",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:prod": "node --enable-source-maps dist/jobs/migrate.js",
    "db:seed": "NODE_OPTIONS=--conditions=development tsx scripts/seed.ts",
    "media:cleanup": "NODE_OPTIONS=--conditions=development tsx src/jobs/cleanupMedia.ts",
    "content:reindex": "NODE_OPTIONS=--conditions=development tsx scripts/reindex-content.ts",
    "media:worker": "OTEL_SERVICE_NAME=questaria-media-worker NODE_OPTIONS=--conditions=development tsx --import ./src/instrumentation.ts src/workers/mediaWorker.ts",
    "media:worker:dev": "OTEL_SERVICE_NAME=questaria-media-worker NODE_OPTIONS=--conditions=development tsx watch --import ./src/instrumentation.ts src/workers/mediaWorker.ts",
    "storage:check": "NODE_OPTIONS=--conditions=development tsx scripts/check-storage.ts",
    "mail:check": "NODE_OPTIONS=--conditions=development tsx scripts/check-mail.ts",
    "redis:check": "NODE_OPTIONS=--conditions=development tsx scripts/check-redis.ts",
    "openapi:export": "NODE_OPTIONS=--conditions=development tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/lib-storage": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@clerk/backend": "^3.31.4",
    "@fastify/cors": "^11.1.0",
    "@fastify/otel": "^1.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@sentry/core": "^11.16.0",
    "@sentry/node": "^11.16.0",
    "altcha-lib": "2.8.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^7.0.0",
    "import-in-the-middle": "^3.6.0",
    "ioredis": "^5.11.1",
    "markdown-it": "^14.3.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "jest": "^30.2.0",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
