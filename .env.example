APP_ENV=development
COMPOSE_PROFILES=${COMPOSE_PROFILES:-${APP_ENV:-production}}

CONTAINER_HOST=0.0.0.0
BACKEND_PORT=3100
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
DB_PORT=55432
# Password of the compose database (required). Use a long random value outside development;
# it is part of DATABASE_URL, so URL-encode special characters or stick to [A-Za-z0-9].
# An existing volume keeps the password it was created with.
POSTGRES_PASSWORD=postgres
# Local Adminer dashboard (development profile only)
DB_DASHBOARD_PORT=8081
TEST_DB_PORT=55433
TEST_RUSTFS_PORT=59000
DB_INTERNAL_PORT=5432
DB_TEST_INTERNAL_PORT=5432
API_DOMAIN=api.localhost
FRONTEND_DOMAIN=app.localhost
COMPOSE_BACKEND_PUBLIC_BASE_URL=https://api.localhost:8443
COMPOSE_BACKEND_PUBLIC_API_URL=https://api.localhost:8443/api/v1
COMPOSE_FRONTEND_PUBLIC_URL=https://app.localhost:8443
COMPOSE_MAILPIT_UI_URL=http://localhost:8025
S3_DOMAIN=s3.localhost
COMPOSE_STORAGE_S3_PUBLIC_ENDPOINT=https://s3.localhost:8443

# Local helper services (development profile only)
RUSTFS_API_PORT=9000
RUSTFS_DASHBOARD_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
